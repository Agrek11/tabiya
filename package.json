{
  "name": "tabiya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:size": "tsc -b && vite build && node scripts/check-explain-size.js",
    "check:bundle": "npm run build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:phase3-smoke": "vitest run tests/lichess/detect-oob.test.ts tests/lichess/sync.test.ts tests/lichess/repository.test.ts tests/lichess/chesscom.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:wrangler": "PLAYWRIGHT_SERVER=wrangler playwright test --project=chromium",
    "check:assets": "node scripts/check-runtime-assets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run check:bundle && npm run check:assets",
    "cf:dev": "npm run build && wrangler dev",
    "cf:dry-run": "npm run verify && wrangler deploy --dry-run",
    "cf:deploy": "npm run verify && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "chess.js": "1.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.460.0",
    "openai": "^6.39.1",
    "react": "^19.2.5",
    "react-chessboard": "5.10.0",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.1.0",
    "stockfish.wasm": "^0.10.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-arm64-gnu": "^1.0.0-rc.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
