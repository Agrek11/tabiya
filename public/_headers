/*
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; worker-src 'self' blob:; connect-src 'self' https://lichess.org https://api.lichess.org https://api.chess.com https://www.chess.com https://api.openai.com https://api.anthropic.com http://localhost:11434 http://127.0.0.1:11434; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/catalog.json
  Cache-Control: public, max-age=0, must-revalidate
/features.json
  Cache-Control: public, max-age=0, must-revalidate
/transpositions.json
  Cache-Control: public, max-age=0, must-revalidate
/stockfish/*
  Cache-Control: public, max-age=0, must-revalidate
/sounds/*
  Cache-Control: public, max-age=0, must-revalidate
